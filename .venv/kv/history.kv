<HistoryScreen>:
    canvas.before:
        Color:
            rgba: 0.96, 0.99, 0.97, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [14, 12, 14, 12]
        spacing: 10

        BoxLayout:
            size_hint_y: None
            height: 44
            spacing: 8

            Button:
                text: 'Назад'
                size_hint_x: None
                width: 68
                background_normal: ''
                background_color: 0.15, 0.68, 0.31, 1
                color: 1, 1, 1, 1
                on_press: root.go_back()

            Label:
                text: root.title
                bold: True
                color: 0.1, 0.46, 0.23, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Button:
                text: 'Обновить'
                size_hint_x: None
                width: 84
                background_normal: ''
                background_color: 0.15, 0.68, 0.31, 1
                color: 1, 1, 1, 1
                on_press: root.refresh()

        Label:
            text: root.error_message
            color: 0.85, 0.18, 0.18, 1
            text_size: self.width - 12, None
            halign: 'left'
            valign: 'middle'
            size_hint_y: None
            height: self.texture_size[1] + 4 if root.error_message else 0

        RecycleView:
            id: history_rv
            viewclass: 'HistoryCard'
            data: [{'req_type': h.get('type', ''), 'description': h.get('description', ''), 'created_at': h.get('created_at', ''), 'status_id': h.get('status_id', 0), 'equipment_name': h.get('equipment_name', ''), 'is_empty': False} for h in root.history] if root.history else [{'req_type': '', 'description': 'Записей пока нет', 'created_at': '', 'status_id': 0, 'equipment_name': '', 'is_empty': True}]
            RecycleBoxLayout:
                default_size: None, dp(132)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                spacing: 8
                orientation: 'vertical'

        Label:
            text: 'Загрузка...' if root.loading else ''
            size_hint_y: None
            height: 22 if root.loading else 0
            color: 0.36, 0.43, 0.37, 1

<HistoryCard@BoxLayout>:
    orientation: 'vertical'
    padding: [10, 10, 10, 10]
    spacing: 6
    req_type: ''
    description: ''
    created_at: ''
    status_id: 0
    equipment_name: ''
    is_empty: False
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

    Label:
        text: root.description if root.is_empty else app.root.get_screen('history').get_type_label(root.req_type)
        bold: True
        color: 0.16, 0.22, 0.18, 1
        text_size: self.width - 8, None
        halign: 'left'
        valign: 'middle'
        size_hint_y: None
        height: self.texture_size[1] + 2

    Label:
        text: '' if root.is_empty else root.description
        color: 0.31, 0.4, 0.34, 1
        text_size: self.width - 8, None
        halign: 'left'
        valign: 'top'
        size_hint_y: None
        height: self.texture_size[1] + 2 if not root.is_empty else 0

    Label:
        text: '' if root.is_empty else ('Оборудование: ' + root.equipment_name)
        color: 0.34, 0.44, 0.37, 1
        text_size: self.width - 8, None
        halign: 'left'
        valign: 'middle'
        size_hint_y: None
        height: self.texture_size[1] + 2 if not root.is_empty else 0

    Label:
        text: '' if root.is_empty else ('Статус: ' + app.root.get_screen('history').get_status_label(root.status_id) + ' | ' + root.created_at)
        color: 0.22, 0.56, 0.28, 1
        text_size: self.width - 8, None
        halign: 'left'
        valign: 'middle'
        size_hint_y: None
        height: self.texture_size[1] + 2 if not root.is_empty else 0
